#usda 1.0
(
    defaultPrim = "antbot"
    subLayers = [
        @./configuration/antbot_physics.usd@
    ]
)

over Xform "antbot"
{
    over "base_link"
    {
        over "lidar_2d_back_link"
        {
            def Xform "sim_lidar"
            {
            }
        }

        over "lidar_2d_front_link"
        {
            def Xform "sim_lidar"
            {
            }

            over "lidar_2d_front_sensor"
            {
                over "RPLidar_mesh"
                {
                    quatd xformOp:orient = (1, 0, 0, 0)
                    float3 xformOp:scale = (1, 1, 1)
                    double3 xformOp:translate = (0, 0, -0.0205)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
                }
            }
        }

        over "lidar_3d_link"
        {
            def Xform "sim_lidar"
            {
            }

            over "OS0"
            {
                over "os0_mesh"
                {
                    double3 xformOp:rotateXYZ = (90, 0, 90)
                    double3 xformOp:scale = (0.1, 0.1, 0.1)
                    double3 xformOp:translate = (0, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
                }
            }
        }

        over "camera_stereo_front_depth_link"
        {
            over "camera_stereo_front_sensor"
            {
                over "RSD455"
                {
                }
            }
        }
    }

    over "front_left_steering_link"
    {
    }

    over "front_left_wheel_link"
    {
    }

    over "front_right_steering_link"
    {
    }

    over "front_right_wheel_link"
    {
    }

    over "rear_left_steering_link"
    {
    }

    over "rear_left_wheel_link"
    {
    }

    over "rear_right_steering_link"
    {
    }

    over "rear_right_wheel_link"
    {
    }

    over "joints"
    {
        over "steering_front_left_joint"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "steering_front_right_joint"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "steering_rear_left_joint"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "steering_rear_right_joint"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }
    }
}
