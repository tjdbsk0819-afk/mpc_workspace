FROM ros:jazzy-ros-base-noble
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 RMW_IMPLEMENTATION=rmw_zenoh_cpp \
    ROS_LOG_DIR=/tmp/dmpc_ros_logs VIRTUAL_ENV=/opt/dmpc-venv
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake python3-pip python3-venv python3-colcon-common-extensions \
    ros-jazzy-rmw-zenoh-cpp ros-jazzy-ros2-control ros-jazzy-ros2-controllers \
    ros-jazzy-xacro ros-jazzy-robot-state-publisher ros-jazzy-generate-parameter-library \
    ros-jazzy-realtime-tools ros-jazzy-backward-ros ros-jazzy-rosidl-default-generators \
    ros-jazzy-nav2-controller ros-jazzy-nav2-regulated-pure-pursuit-controller \
    libboost-json-dev libeigen3-dev \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv --system-site-packages /opt/dmpc-venv
ENV PATH=/opt/dmpc-venv/bin:$PATH
WORKDIR /workspace
COPY pyproject.toml ./
COPY dmpc_runtime ./dmpc_runtime
COPY isaac/simulation ./isaac/simulation
RUN python -m pip install --no-cache-dir numpy==1.26.4 casadi==3.7.0 PyYAML==6.0.2 \
    && python -m pip install --no-cache-dir --no-deps .
COPY isaac/docker/ros-entrypoint.sh /opt/dmpc/ros-entrypoint.sh
RUN chmod 755 /opt/dmpc/ros-entrypoint.sh
ENTRYPOINT ["/opt/dmpc/ros-entrypoint.sh"]
CMD ["bash"]
