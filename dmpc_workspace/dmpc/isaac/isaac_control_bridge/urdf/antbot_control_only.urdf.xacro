<?xml version="1.0"?>
<robot name="antbot_control_only" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find antbot_isaac_control)/urdf/ros2_control_isaac.xacro"/>

  <!--
    This is a control-only model for controller_manager. Isaac Lab continues
    to own and render the real USD articulation in run_antbot.py.
  -->
  <link name="base_link"/>

  <xacro:macro name="steering_control_joint" params="name">
    <link name="${name}_control_link"/>
    <joint name="${name}" type="revolute">
      <parent link="base_link"/>
      <child link="${name}_control_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.959" upper="0.959" effort="1000.0" velocity="6.5"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="wheel_control_joint" params="name">
    <link name="${name}_control_link"/>
    <joint name="${name}" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_control_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="200.0" velocity="50.0"/>
    </joint>
  </xacro:macro>

  <xacro:steering_control_joint name="steering_front_left_joint"/>
  <xacro:steering_control_joint name="steering_front_right_joint"/>
  <xacro:steering_control_joint name="steering_rear_left_joint"/>
  <xacro:steering_control_joint name="steering_rear_right_joint"/>

  <xacro:wheel_control_joint name="wheel_front_left_joint"/>
  <xacro:wheel_control_joint name="wheel_front_right_joint"/>
  <xacro:wheel_control_joint name="wheel_rear_left_joint"/>
  <xacro:wheel_control_joint name="wheel_rear_right_joint"/>

  <xacro:antbot_isaac_ros2_control/>

</robot>
