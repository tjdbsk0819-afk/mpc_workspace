<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="antbot_isaac_ros2_control">
    <ros2_control name="antbot_isaac_system" type="system">
      <hardware>
        <plugin>antbot_isaac_control/IsaacTopicSystem</plugin>
        <param name="state_topic">/joint_states</param>
        <param name="command_topic">/joint_command</param>
        <param name="state_timeout_sec">0.5</param>
        <param name="activation_timeout_sec">5.0</param>
      </hardware>

      <joint name="steering_front_left_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
      </joint>
      <joint name="steering_front_right_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
      </joint>
      <joint name="steering_rear_left_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
      </joint>
      <joint name="steering_rear_right_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
      </joint>

      <joint name="wheel_front_left_joint">
        <command_interface name="velocity"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="wheel_front_right_joint">
        <command_interface name="velocity"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="wheel_rear_left_joint">
        <command_interface name="velocity"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="wheel_rear_right_joint">
        <command_interface name="velocity"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>
  </xacro:macro>

</robot>
