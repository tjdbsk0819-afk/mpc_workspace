{
  mode: "client",
  connect: {
    endpoints: ["tcp/localhost:7447"],
    timeout_ms: { client: -1 },
  },
  listen: {
    endpoints: ["tcp/127.0.0.1:0"],
  },
  transport: {
    shared_memory: {
      enabled: false,
      transport_optimization: { enabled: false },
    },
  },
  scouting: {
    multicast: { enabled: false },
  },
  // rmw_zenoh_cpp uses AdvancedPublisher for transient-local and
  // introspection topics. AdvancedPublisher requires Zenoh timestamping.
  timestamping: {
    enabled: { router: true, peer: true, client: true },
    drop_future_timestamp: false,
  },
}
