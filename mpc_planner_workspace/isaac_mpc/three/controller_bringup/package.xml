<?xml version="1.0"?>
<package format="3">
  <name>antbot_mpc_ros</name>
  <version>0.1.0</version>
  <description>AntBot GT/CV peer prediction, controller launch, and legacy MPC ROS adapters.</description>
  <maintainer email="maintainer@example.com">AntBot project</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>antbot_navigation</exec_depend>
  <exec_depend>mpc_planner_antbot</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>antbot_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
