cmake_minimum_required(VERSION 3.8)
project(mpc_planner_solver)
set(CMAKE_CXX_STANDARD 17)
find_package(ament_cmake REQUIRED)
find_package(mpc_planner_util REQUIRED)
# This is generated by the original generate_solver(), including acados sources/libs.
include(solver.cmake)
add_library(${PROJECT_NAME} SHARED src/state.cpp src/mpc_planner_parameters.cpp ${solver_SOURCES})
target_include_directories(${PROJECT_NAME} PUBLIC
  $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
  $<INSTALL_INTERFACE:include>)
foreach(folder IN LISTS solver_INCLUDE_DIRS)
  get_filename_component(folder_abs "${folder}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
  target_include_directories(${PROJECT_NAME} PUBLIC $<BUILD_INTERFACE:${folder_abs}>)
endforeach()
target_compile_definitions(${PROJECT_NAME} PUBLIC ACADOS_SOLVER)
target_include_directories(${PROJECT_NAME} PUBLIC
  $ENV{ACADOS_SOURCE_DIR}/include
  $ENV{ACADOS_SOURCE_DIR}/include/blasfeo/include
  $ENV{ACADOS_SOURCE_DIR}/include/hpipm/include)
ament_target_dependencies(${PROJECT_NAME} mpc_planner_util)
target_link_libraries(${PROJECT_NAME} ${solver_LIBRARIES})
install(TARGETS ${PROJECT_NAME} EXPORT export_${PROJECT_NAME} LIBRARY DESTINATION lib)
install(DIRECTORY include/${PROJECT_NAME} DESTINATION include)
install(DIRECTORY acados/Solver DESTINATION include
  FILES_MATCHING PATTERN "*.h")
install(DIRECTORY acados/Solver/ DESTINATION lib FILES_MATCHING PATTERN "*.so")
ament_export_targets(export_${PROJECT_NAME} HAS_LIBRARY_TARGET)
ament_export_dependencies(mpc_planner_util)
ament_package()
